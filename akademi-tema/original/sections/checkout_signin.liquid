<div class="checkout__form">
  {% unless page.cart.is_free or page.cart.is_free_trial %}
    <ul class="progress-bar">
      <li class="active">{{ 'checkouts.new.list_item_1' | translate }}</li>
      <li>{{ 'checkouts.new.list_item_2' | translate }}</li>
    </ul>
  {% endunless %}

  <section aria-labelledby="checkout-form-heading-sign-in" class="checkout__form--sign-in">
    <h1 class="checkout__heading" id="checkout-form-heading-sign-in">
      {{ 'liquid.views.sign_in_page.header_welcome_back' | translate }}
    </h1>
    <div class="checkout__sign-up">
      <a id="button__sign-up" href="#">
        {{ 'liquid.views.sign_in_page.link_create_account' | translate }}
      </a>
    </div>
    {% form 'checkout_sign_in' %}
      {% if errors.size > 0 %}
        {% include 'form_errors' %}
      {% endif %}

      <div class="form__group">
        {% assign field = fields.email %}
        <label for="{{ field.name }}" class="form__label">
          {{ field.label }}
        </label>
        <input
          type="email"
          id="{{ field.name }}"
          name="{{ field.name }}"
          value="{{ field.value }}"
          placeholder="{{ field.placeholder }}"
          autocapitalize="off"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          {% if field.required %}required{% endif %}
          class="form__control"
        />
      </div>

      <div class="form__group">
        {% assign field = fields.password %}
        <label for="user[sign-in][email]" class="form__label">
          {{ field.label }}
        </label>
        <input
          type="password"
          id="user[sign-in][email]"
          name="{{ field.name }}"
          placeholder="{{ field.placeholder }}"
          autocapitalize="off"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          {% if field.required %}required{% endif %}
          class="form__control"
        />
      </div>

      <div class="form__group form__remember-me">
        {% assign field = fields.remember_me %}
        {% comment %}
          This hidden input is necessary so that things behave correctly when the checkbox is left unticked.
        {% endcomment %}
        <input type="hidden" name="{{ field.name }}" value="0" />
        <input type="checkbox" id="{{ field.name }}" name="{{ field.name }}" value="{{ field.value }}" />
        <label class="form__label--checkbox" for="{{ field.name }}">
          {{ field.label }}
        </label>
        <a href="{{ page.forgot_password_url }}" class="form__forgot-password">
          {{ 'liquid.views.sign_in_page.forgot_password' | translate }}
        </a>
      </div>

      {% if site.invisible_recaptcha_enabled %}
        {% include 'checkout_recaptcha', submitName: 'submitSignin', formSelector: 'sign-in' %}
      {% else %}
        <div class="form__button-group">
          <button
            type="submit"
            value="{{ fields.submit.label }}"
            class="button button-primary"
            id="signin"
          >
            {{ fields.submit.label }}
          </button>
        </div>
      {% endif %}
    {% endform %}

    {% include 'remote_sign_in' %}
  </section>

  <section aria-labelledby="create-account-heading" class="checkout__form--sign-up" id="create-account">
    <h2 class="page__heading" id="create-account-heading">
      {% if page.is_social_sign_up_step_two %}
        {{ 'liquid.views.sign_up_page.header_complete_social_sign_up' | translate }}
      {% else %}
        {{ 'liquid.views.sign_up_page.header_create_account' | translate }}
      {% endif %}
    </h2>
    <div class="checkout__sign-in">
      <span>{{ 'liquid.views.sign_up_page.intro_sign_in' | translate }} </span>
      <a id="button__sign-in" href="#">
        {{ 'liquid.views.sign_up_page.short_link_sign_in' | translate }}
      </a>
    </div>

    {% form 'checkout_sign_up' %}
      {% if errors.size > 0 %}
        {% include 'form_errors' %}
      {% endif %}

      {% if fields.first_name || fields.last_name %}
        <div class="form__group">
          <div class="input__group">
            {% assign field = fields.first_name %}
            <label for="{{ field.name }}" class="form__label">
              {{ field.label }}
            </label>
            <input
              type="text"
              id="{{ field.name }}"
              name="{{ field.name }}"
              value="{{ field.value }}"
              placeholder="{{ field.placeholder }}"
              data-qa="sign-up-first-name__input"
              {% if field.required %}required{% endif %}
              autocapitalize="off"
              autocomplete="off"
              autocorrect="off"
              spellcheck="false"
              class="form__control"
            />
          </div>
          <div class="input__group">
            {% assign field = fields.last_name %}
            <label for="{{ field.name }}" class="form__label">
              {{ field.label }}
            </label>
            <input
              type="text"
              id="{{ field.name }}"
              name="{{ field.name }}"
              value="{{ field.value }}"
              data-qa="sign-up-last-name__input"
              placeholder="{{ field.placeholder }}"
              {% if field.required %}required{% endif %}
              autocapitalize="off"
              autocomplete="off"
              autocorrect="off"
              spellcheck="false"
              class="form__control"
            />
          </div>
        </div>
      {% endif %}

      {% if fields.email %}
        {% assign field = fields.email %}
        <div class="form__group">
          <label for="{{ field.name }}" class="form__label">
            {{ field.label }}
          </label>
          <input
            type="email"
            id="{{ field.name }}"
            name="{{ field.name }}"
            value="{{ field.value }}"
            placeholder="{{ field.placeholder }}"
            data-qa="sign-up-email__input"
            {% if field.required %}required{% endif %}
            autocapitalize="off"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
            class="form__control"
          />
        </div>
      {% endif %}

      {% if fields.password %}
        {% assign field = fields.password %}
        <div class="form__group">
          <label for="{{ field.name }}" class="form__label">
            {{ field.label }}
          </label>
          <input
            type="password"
            id="{{ field.name }}"
            name="{{ field.name }}"
            placeholder="{{ field.placeholder }}"
            data-qa="sign-up-password__input"
            {% if field.required %}required{% endif %}
            autocapitalize="off"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
            class="form__control"
          />
        </div>
      {% endif %}

      {% for field in custom_signup_fields %}
        <div class="form__group">
          {{ field.hidden_input }}
          {% if field.type_is_country %}
            <div class="form__select-label">
              <label for="{{ field.name }}" class="form__label">
                {{ field.label }}
              </label>
              <select id="{{ field.name }}" name="{{ field.name }}" {% if field.required %}required{% endif %} class="form__control">
                {{ field.country_options }}
              </select>
            </div>
          {% else %}
            <label for="{{ field.name }}" class="form__label">
              {{ field.label }}
            </label>
            <input
              type="text"
              id="{{ field.name }}"
              name="{{ field.name }}"
              value="{{ field.value }}"
              placeholder="{{ field.label }}"
              {% if field.required %}required{% endif %}
              class="form__control"
            />
          {% endif %}
        </div>
      {% endfor %}

      {% if fields.terms != blank %}
        {% assign field = fields.terms %}
        <div class="form__group">
          {% comment %}
            This hidden input is necessary so that things behave correctly when the checkbox is left unticked.
          {% endcomment %}
          <div>
            <input type="hidden" name="{{ field.name }}" value="0" />
            <input
              type="checkbox"
              id="{{ field.name }}"
              name="{{ field.name }}"
              value="{{ field.value }}"
              required class="form__control"
            />
            <label for="{{ field.name }}">
              {{ field.label }}
            </label>
          </div>
        </div>
      {% endif %}

      {% comment %}
        This CSS hidden input is necessary to stop spam bots from creating student accounts.
      {% endcomment %}
      <div class="form__group honeypot-field">
        <label aria-hidden="true" for="confirm-email">{{ 'liquid.views.sign_up_page.honeypot_field_label' | translate }}</label>
        <input aria-hidden="true" type="text" name="confirm-email" id="confirm-email" autocomplete="off" tabindex="-1">
      </div>

      {% if site.invisible_recaptcha_enabled %}
        {% include 'checkout_recaptcha', submitName: 'submitSignup', formSelector: 'sign-up' %}
      {% else %}
        <div class="form__button-group">
          <button
            type="submit"
            value="{{ fields.submit.label }}"
            class="button button-primary"
            id="signup"
            data-qa="sign-up__btn"
          >
            {{ fields.submit.label }}
          </button>
        </div>
      {% endif %}
    {% endform %}

    {% include 'remote_sign_in' %}
  </section>
</div>

{% schema %}
{
  "label":"Default",
  "description":"This is a default section — the foundation of your Thinkific site.  While this section is not editable, you can customize this page by adding new sections.",
  "settings":[]
}
{% endschema %}
