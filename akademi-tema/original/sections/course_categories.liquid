{% assign sectionLabel = section.settings.heading %}
<section
  aria-label="{{ sectionLabel | escape }}"
  class="course-categories section-height__medium {% include 'section_utility_heading_alignment' %}"
  data-preview-item="course-categories">
  <div class="course-categories__container">
    {% include 'section_headings' %}
    <div class="section__content">
      {% if section.blocks != empty %}
        <ul class="products__list">
          {% for block in section.blocks %}
          {% assign category = block.settings.category %}
            <li class="products__list-item">
              {% include 'category_card' product: category %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</section>

{% style %}

.course-categories {
  {% include 'section_style_heading_alignment' %}

  {% if section.settings.section_padding_top %}
    .course-categories__container {
      padding-top: 0;
    }
  {% endif %}

  {% if section.settings.section_padding_bottom %}
    .course-categories__container {
      padding-bottom: 0;
    }
  {% endif %}
}

{% endstyle %}

{% schema %}
{
  "label":"Categories",
  "description":"",
  "previewImageUrl":"https://cdn.thinkific.com/57/20210222/ad6fc686393952d8b0f24902ca7ef1f4.png",
  "previewDescription":"Show specific categories",
  "settings":[
    {
      "label":"Headings",
      "settings":[
        {
          "type":"text",
          "id":"heading",
          "label":"Heading",
          "default":"Categories"
        },
        {
          "type":"text",
          "id":"subheading",
          "label":"Subheading",
          "default":""
        },
        {
          "type":"radio",
          "id":"heading_alignment",
          "label":"Alignment",
          "description":"",
          "default":"center",
          "options":[
            {
              "value":"left",
              "label":"Left"
            },
            {
              "value":"center",
              "label":"Center"
            },
            {
              "value":"right",
              "label":"Right"
            }
          ]
        }
      ]
    },
    {
      "label":"Layout",
      "settings":[
        {
          "type":"checkbox",
          "id":"section_padding_top",
          "label":"Remove top section padding",
          "default":false
        },
        {
          "type":"checkbox",
          "id":"section_padding_bottom",
          "label":"Remove bottom section padding",
          "default":false
        }
      ]
    }
  ],
  "blocks":{
    "label":"Add category",
    "limit":12,
    "types":[
      {
        "type":"category",
        "label":"Category",
        "settings":[
          {
            "type":"category_picker",
            "id":"category",
            "label":"Category"
          },
          {
            "type":"checkbox",
            "id":"show_category_name",
            "label":"Show category name",
            "default":true
          }
        ]
      }
    ],
    "defaults":[]
  }
}
{% endschema %}
