// Course Curriculum
// ======================================

.course-curriculum {
  &__container {
    @include make-container;
    @include screen-md-max {
      & header {
        margin-bottom: $margin-3;
      }
    }
  }

  .section__subheading {
    @include screen-sm-min {
      margin-top: $margin-base;
    }
    margin-bottom: 0;
  }


  &__content {
    @include screen-md-max {
      flex-direction: column;
    }
    display: flex;

    gap: 0 40px;
  }

  &__chapter-container {
    @include screen-md-max {
      margin-bottom: 40px;
    }
    @include flex-grow(1);

    &--empty {
      @include screen-md-max {
        flex-direction: column;
      }
      display: flex;
    }

    gap: 0 40px;
  }

  &__chapter-list {
    @include make-row(false);
    align-self: flex-start;
    width: 100%;
    list-style: none;

    .course-curriculum__chapter {
      border-bottom: 1px solid $body__text-color;
    }

    &--empty {
      margin-bottom: 40px;
      opacity: 40%;

      ol {
        width: 100%;
        margin-left: 0;
      }
    }
  }

  button.course-curriculum__chapter-header {
    margin: 4px; // required to see the focus state
    width: calc(100% - 8px);
    cursor: pointer;
  }

  &__chapter-header {
    display: flex;
    position: relative;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: $padding-3;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;

    .toga-icon {
      @include transition(all 0.25s ease);
      color: $accent__color;
      font-size: 1.5rem;
    }

    &.collapse {
      .toga-icon {
        transform: rotate(-180deg);
      }

      .course-curriculum__chapter-title {
        position: relative;
      }

      .course-curriculum__chapter-content {
        opacity: 0;
      }
    }
  }

  &__chapter-content {
    @include transition(opacity 200ms ease);
    padding: 0 $padding-3 $padding-base;
    list-style: none;

    a {
      text-decoration: none;

      p {
        text-decoration: underline;
      }

      &:active,
      &:hover {
        p {
          text-decoration: none;
        }
      }
    }

    li {
      position: relative;
      margin-bottom: 1em;
      line-height: 1.5;
    }

    &--collapsed {
      display: none;
    }
  }

  &__chapter {
    @include make-col(12);
    display: flex;

    padding-right: 0;
    padding-left: 0;
    line-height: 1;
  }

  &__chapter-content-wrapper {
    @include flex-grow(1);
    overflow: hidden;

    ol {
      margin: 0;
      list-style: none;
    }

    &.disabled {
      pointer-events: none;
    }
  }

  &__chapter-title {
    position: relative;
    margin: 0;
    padding-right: $gutter-width;
    font-family: $body__font-family;
    font-size: $body__font-size * 1.2;
    font-weight: $body__font-weight;
  }

  &__lesson-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    p {
      margin: $margin-base / 2 0;
      padding-right: 1rem;
    }
  }

  &__chapter-lesson {
    display: flex;

    &--free {
      margin: $margin-base / 2 0;
      padding: 5px $padding-base;
      border-radius: 5px;
      background-color: $accent__color;
      color: dynamic-contrast-color($accent__color);
      font-size: $body__font-size * 0.875;
      line-height: 1;
      text-transform: uppercase;
    }

    i {
      margin: $margin-base / 2 0;
      padding-right: 1rem;
      font-size: 1.5rem;
      vertical-align: sub;
    }
  }

  &__chapter-toggle {
    .button--link {
      margin-top: $gutter-width;
      padding: 0;
      border: 0;
      background: none;
      color: $link__color;
      font-family: $body__font-family;
      font-weight: normal;
      text-transform: none;

      &:hover,
      &:active,
      &:focus {
        cursor: pointer;
      }
    }
  }

  &__card {
    margin-bottom: $margin-2;
  }
}

.course-curriculum-card {
  @include screen-md-min {
    width: 418px;
  }

  border-radius: 4px;
  background-color: $interface__background-color;
  box-shadow: 0 8px 12px rgba(0, 0, 0, 0.15);
  overflow: hidden;

  &__image {
    display: flex;
    position: relative;
  }

  img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  &__details {
    @include screen-md-min {
      padding: $padding-3 38px 0;
    }

    padding: $padding-3 $padding-3 0;

    &__title {
      position: relative;
      margin-bottom: $margin-2;
      line-height: 30px;
    }

    hr {
      max-width: 46px;
      height: 1px;
      margin: 0 0 $margin-3;
      border: 0;
      background-color: $body__text-color;
    }

    ul {
      margin-left: 0;
      list-style: none;
    }

    &-item {
      display: flex;
      margin-bottom: $margin-2;

      &:last-child {
        margin-bottom: $margin-3;
      }

      i {
        flex: 0 0 26px;
        color: $accent__color;
        font-size: 24px;
      }

      span {
        margin-left: $margin-2;
        font-size: 20px;
        font-style: normal;
        font-weight: normal;
        line-height: 25px;
      }
    }
  }
}
