{% comment %}
  This is the page students will see when they log in. It shows all of
  the products they have access to, and lets them filter their courses by
  Completed, In Progress or Expired.
{% endcomment %}

<main class="student-dashboard" id="main-content">
  {% section 'student_dashboard' %}
  {{ content_for_page }}
</main>

{% schema %}
{
  "sections":{
    "options":[
      "banner",
      "course_cards",
      "frequently_asked_questions",
      "call_to_action",
      "countdown",
      "video"
    ],
    "defaults":[]
  }
}
{% endschema %}

{% include 'dashboard_footer_scripts' %}
