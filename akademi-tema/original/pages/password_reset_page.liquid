{% comment %}
  This is the page where the user can reset their password
{% endcomment %}

<main class="password-reset" id="main-content">
  <div class="password-reset__container">
    <div class="password-reset__wrapper">
      <div class="password-reset__form">
        <h1 class="page__heading">{{ 'liquid.views.password_reset_page.title_edit' | translate }}</h1>
        {% form 'password_reset' %}
        {% if errors.size > 0 %}
          {% include 'form_errors' %}
        {% endif %}
        {% assign field = fields.reset_password_token %}
        <input type="hidden" value="{{ field.value }}" name="{{ field.name }}" />
        {% include 'password_field' %}
        {% include 'password_confirm_field' %}
        <div class="form__button-group">
          <input type="submit" name="commit" value="{{ fields.submit.label }}" class="button button-primary" />
        </div>
        {% endform %}
      </div>
    </div>
  </div>
</main>

{% include 'form_validation_script' %}
