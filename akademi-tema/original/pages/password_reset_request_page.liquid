{% comment %}
  This is the page where the user can request a new password
{% endcomment %}

<main class="password-reset" id="main-content">
  <div class="password-reset__container">
    <div class="password-reset__wrapper">
      <div class="password-reset__form">
        <h1 class="password-reset__heading">{{ 'liquid.views.password_reset_request_page.text_forgot_password' | translate }}</h1>
        {% form 'password_reset_request' novalidate: 'novalidate' %}
          {% if errors.size > 0 %}
            {% include 'form_errors' %}
          {% endif %}
          <p>{{ 'liquid.views.password_reset_request_page.text_explanation' | translate }}</p>
          {% include 'email_field' %}
          <div class="form__button-group">
            <input type="submit" name="commit" value="{{ fields.submit.label }}" class="button button-primary" />
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</main>

{% include 'form_validation_script' %}
