<div class="form__group">
  {% assign field = fields.password %}
  <label for="{{ field.name }}" class="form__label">
    {{ field.label }}
  </label>

  <input
    type="password"
    id="{{ field.name }}"
    name="{{ field.name }}"
    placeholder="{{ field.placeholder }}"
    {% if field.required %}required aria-describedby="{{ field.name }}-error"{% endif %}
    autocapitalize="off"
    autocomplete="off"
    autocorrect="off"
    spellcheck="false"
    class="form__control"
  />

  {% if field.required %}
    <p id="{{ field.name }}-error" class="form__error-msg hidden">
      {{ 'liquid.partials.form.field_cannot_be_blank' | translate }}
    </p>
  {% endif %}
</div>
