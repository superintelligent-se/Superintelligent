// Page Header
// ======================================

.header {
  @include transition(background-color 400ms ease, box-shadow 200ms ease);

  position: relative;
  border-bottom: $interface__border;
  background-color: $nav__background-color;
  z-index: z-index(navigation--background);

  .home-landing-page &,
  .course-landing-page &,
  .bundle-landing-page &,
  .page-template &,
  .coming-soon-page &,
  .student-dashboard &,
  .student-certificate-page &,
  .collections-landing-page & {
    border-bottom: $interface__border;

    &.fixed {
      @include screen-md-min {
        @include transition(background-color 400ms ease, box-shadow 200ms ease);

        position: fixed;
        top: 0;
        right: 0;
        left: 0;
        width: 100%;
        margin: 0 auto;
        background-color: $nav__fixed-background-color;
        box-shadow: $shadow-menu;

        &:not([data-menu-style="floating"]) {
          .header__nav-item,
          .header__school-name {
            & > a,
            & > button {
              &:not(.button-secondary) {
                color: $nav__fixed-link-color;

                &:active,
                &:hover,
                &:focus {
                  color: $nav__fixed-link-color--active;
                }
              }
            }
          }
        }
      }
    }
  }
}

.header__container {
  @include make-container;
  padding-inline: $gutter-width / 2;
  padding-block: 24px;
}

.header__wrapper {
  @include make-row(false);
  align-items: center;
  flex-wrap: nowrap;
  justify-content: space-between;

  position: relative;
  margin: 0;
}

.header__logo {
  @include screen-md-min {
    max-width: 12rem;
  }
  @include screen-xl-min {
    max-width: 25rem;
  }

  display: flex;
  flex-wrap: wrap;
  padding-right: $gutter-width / 2;
  width: 100%;
  max-width: 60%;

  img {
    @include screen-lg-min {
      max-width: 100%;
      max-height: 35px;
    }

    width: auto;
    max-width: 100%;
    max-height: 60px;
  }
}

.header__school-name {
  @include screen-xl-min {
    font-size: 1.75rem;
    line-height: 2.5rem;
  }
  
  flex-basis: 100%;
  margin-bottom: 0;
  font-size: 1.5rem;
  font-weight: 600;
  line-height: 2rem;

  a {
    [data-menu-style="floating"] & {
      color: $nav__floating-link-color;
    }
    color: $nav__fixed-link-color;
    text-decoration: none;

    &:active,
    &:hover,
    &:focus {
      text-decoration: underline;
    }
  }
}

// Navigation
.header__nav {
  font-size: 1rem;

  @include screen-sm-max {
    display: block;
    position: absolute;
    top: 160%;
    left: 0;
    width: 100%;
    margin: 0;
    box-shadow: $shadow-3;
    opacity: 0;
    overflow: hidden;
    visibility: hidden;
    z-index: z-index(page-background);

    .header__nav-item {
      display: block;

      a,
      button {
        &:not(.button-secondary) {
          display: block;
          padding: $padding-base $padding-2;
          background-color: $nav__mobile-background-color;
          color: $nav__mobile-link-color;
          font-weight: 600;
          text-align: center;

          &:active,
          &:hover,
          &:focus {
            background-color: darken($nav__mobile-background-color--active, 5%);
            color: $nav__mobile-link-color--active;
            text-decoration: none;
          }
        }
      }

      a {
        text-decoration: none;

        &:active,
        &:hover,
        &:focus {
          text-decoration: underline;
        }
      }

      .dropdown__toggle-button {
        display: none !important; // sass-lint:disable-line no-important
      }
    }
  }
  @include screen-md-min {
    &.header__nav--left {
      & > ul {
        text-align: left;
      }

      .dropdown,
      .header__nav-sign-in {
        float: right;
      }

      .dropdown__menu {
        right: -1rem;
        left: -1rem;
      }
    }
  }
  @include screen-lg-min {
    font-size: 1.125rem;

    &.header__nav--left.header__nav--has-cta {
      .header__nav-sign-in {
        position: relative;
        top: $gutter-width / 4;
      }
    }
  }

  width: 100%;

  & > ul {
    text-align: right;

    & > li {
      @include screen-md-min {
        &:first-child {
          margin-left: 0;
        }
      }
    }
  }
}

[data-menu-style="floating"] {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  background-color: transparent;

  .student-dashboard &,
  .collections-landing-page & {
    position: relative;

    &.fixed {
      position: sticky;
    }
  }

  // Add minimum header height padding to the first section if the menu is floating
  ~ .home,
  ~ .course,
  ~ .bundle,
  ~ .coming-soon,
  ~ .student-certificate,
  ~ .custom {
    > section {
      &:first-of-type {
        padding-top: 4rem;
      }
    }
  }
}

[data-menu-type="header__nav--dropdown"] {
  // This selector is used for specificity to override the [class="header floating"] selector chain
  &.header {
    @include screen-sm-max {
      &[data-menu="open"] {
        .header__nav {
          @include transition(
            opacity 400ms ease,
            visibility 400ms ease,
            z-index 400ms ease
          );

          opacity: 1;
          visibility: visible;
          z-index: z-index(navigation--middleground);
        }
      }
    }
  }
}

[data-menu-type="header__nav--overlay"] {
  // This selector is used for specificity to override the [class="header floating"] selector chain
  &.header {
    @include screen-sm-max {
      &[data-menu="open"] {
        @include transition(
          background-color 200ms ease,
          opacity 400ms ease,
          visibility 400ms ease,
          z-index 400ms ease
        );

        position: fixed;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: $nav__mobile-background-color !important; // sass-lint:disable-line no-important
        z-index: z-index(navigation--middleground);
        overflow-y: scroll;

        .header__nav {
          box-shadow: none;
          opacity: 1;
          visibility: visible;
        }

        .header__school-name {
          color: $nav__mobile-link-color;
        }

        .header__mobile-button {
          z-index: z-index(navigation--foreground);
          color: $nav__mobile-link-color;
        }
      }
    }
  }
}

.header__nav-item {
  @include screen-md-min {
    margin-left: 25px;

    &.dropdown {
      margin-right: 10px;
    }

    & > a,
    & > button {
      &:not(.button-secondary) {
        color: $nav__link-color;
        font-weight: 600;
        text-decoration: none;

        [data-menu-style="floating"] & {
          color: $nav__floating-link-color;
        }

        &:active,
        &:hover,
        &:focus {
          text-decoration: underline;
        }
      }
    }
  }

  display: inline-block;
}

.header__nav-item--default {
  .user-signed-in .dropdown__menu & {
    display: none;
  }

  @include screen-sm-max {
    .user-signed-in &.header__nav-item {
      display: none;
    }

    .user-signed-in .dropdown__menu & {
      display: block;
    }
  }
}

.header__nav-cta {
  @include screen-xl-min {
    display: inline-block;
  }

  display: none;

  a {
    &.button-secondary {
      @include button-secondary;
      width: 100%;
      padding: $padding-base $padding-2;
      font-size: 1rem;
    }
  }
}

.header__user-avatar {
  display: inline-block;
  position: relative;
  width: 32px;
  height: 32px;
  margin: 0 5px;
  border-radius: 50%;
  vertical-align: middle;
}

.header__mobile-button {
  @include screen-md-min {
    display: none;
  }

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  min-width: $mobile-menu__width;
  height: $mobile-menu__height;
  padding: 4px;
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: $button__primary-border-radius;
  box-sizing: border-box;
  color: $nav__link-color;

  &:hover,
  &:active,
  &:focus-visible {
    background-color: $chalk-button__hover-background;
  }

  .menu-icon {
    display: block;
  }

  .close-icon {
    display: none;
  }

  &.open {
    .menu-icon {
      display: none;
    }

    .close-icon {
      display: block;
    }
  }
}

.header__mobile-button__label {
  color: $nav__link-color;
  font-size: 0.75rem;
  line-height: normal;
  text-align: center;
  text-transform: uppercase;
  cursor: pointer;

  [data-menu-style="floating"] & {
    color: $nav__floating-link-color;
  }

  .open & {
    color: $nav__mobile-link-color;
  }
}

.header__mobile-button__toggle-icon {
  @include transition(background $mobile-menu__transition);

  display: flex;
  position: relative;
  width: $mobile-menu__width;
  height: $mobile-menu__height;
  margin: 0;
  padding: 0;
  text-indent: -9999px;
  cursor: pointer;
  overflow: hidden;
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;

  span {
    @include transition(background $mobile-menu__transition ease);

    display: block;
    position: absolute;
    top: ($mobile-menu__height / 3.3);
    right: 0;
    left: 0;
    height: $mobile-menu__thickness;
    background-color: $nav__link-color;

    &:before,
    &:after {
      @include transition-duration(
        $mobile-menu__transition,
        $mobile-menu__transition
      );
      @include transition-delay($mobile-menu__transition, 0s);

      display: block;
      position: absolute;
      left: 0;
      width: 100%;
      height: $mobile-menu__thickness;
      background-color: $nav__link-color;
      content: "";

      .open & {
        @include transition-delay(0s, $mobile-menu__transition);
      }
    }

    &:before {
      @include transition-property(
        top,
        -webkit-transform,
        -moz-transform,
        transform
      );

      top: -$mobile-menu__thickness - $mobile-menu__space;

      .open & {
        top: 0;
        transform: rotate(45deg);
      }
    }

    &:after {
      @include transition-property(
        bottom,
        -webkit-transform,
        -moz-transform,
        transform
      );

      bottom: -$mobile-menu__thickness - $mobile-menu__space;

      .open & {
        bottom: 0;
        transform: rotate(-45deg);
      }
    }

    [data-menu-style="floating"] & {
      background-color: $nav__floating-link-color;

      &:before,
      &:after {
        background-color: $nav__floating-link-color;
      }
    }

    .open & {
      background: none !important; // sass-lint:disable-line no-important
    }
  }
}

// Dropdown(s)
.dropdown {
  position: relative;
}

.dropdown__toggle-button {
  display: flex;
  align-items: center;
  gap: 4px;
  position: relative;
  width: 100%;
  background-color: transparent;
  font-family: inherit;
  cursor: pointer;
  border: 1px solid transparent;
  border-radius: $button__primary-border-radius;
  padding: 4px $padding-2; 
  text-decoration: none;

  &:hover,
  &:active,
  &:focus-visible,
  &[aria-expanded="true"] {
    background-color: $chalk-button__hover-background;
  }
}

.dropdown__menu {
  @include screen-md-min {
    @include dropdown(".dropdown.open");

    width: auto;
    background-color: $dropdown__background-color;
    border: $interface__border;
    margin-top: 4px;

    li {
      display: block;

      &.dropdown__menu-item {
        margin-bottom: $margin-base;

        a {
          @include transition(none);

          display: block;
          padding: $padding-base $padding-2;
          margin: 2px;
          background-color: $dropdown__link-background-color;
          color: $dropdown__link-color;
          font-size: 1rem;
          font-weight: 600;
          text-align: left;
          text-decoration: none;
        }
      }
    }
  }
}
