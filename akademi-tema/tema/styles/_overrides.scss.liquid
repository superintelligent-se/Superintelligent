// Overrides
// ======================================

// Superintelligent
// ======================================
// Sajtens designspråk från www.superintelligent.se (src/site/site.css):
// mörk bana, frågetecken-block, plattformar, tegelmark och HUD-etiketter i
// pixelfont. Akademin är träning, och träning är grönt på sajten.
//
// Färgerna i temainställningarna har samma värden som standard. Det som
// gäller hela Akademin står först, kurssidans bana sist.

:root {
  --si-bg: #0a0e17;
  --si-bg-alt: #0d1220;
  --si-panel: #131a28;
  --si-line: #24304a;
  --si-ink: #f2f5fa;
  --si-ink-2: #cdd3e3;
  --si-muted: #a3adc8;
  --si-faint: #8892b0;
  --si-gold: #e0b23c;
  --si-gold-dark: #b8860b;
  --si-green: #2e9e63;
  --si-green-dark: #1c7a49;
  --si-green-text: #3fbf7f;
  --si-plat: #2a3550;
  --si-plat-top: #3d4b6e;
  --si-ground: #1b2436;
  --si-pixel: 'Silkscreen', ui-monospace, monospace;
  --si-mono: 'IBM Plex Mono', ui-monospace, monospace;
  --si-sans: 'Hanken Grotesk', system-ui, sans-serif;
}

// Hela Akademin: typsnitt, knappar och fokus
// ======================================

body {
  font-family: var(--si-sans);
}

h1,
h2,
h3,
h4,
.section__heading,
.section__heading--secondary,
.section__subheading,
.button,
.form__control {
  font-family: var(--si-sans);
}

.section__heading {
  font-weight: 800;
  letter-spacing: -0.02em;
}

:focus-visible {
  outline: 3px solid var(--si-gold);
  outline-offset: 3px;
}

// Knapparna har sajtens hårda pixelskugga och trycks ner när man klickar
.button-primary,
.button-secondary {
  border-radius: 0;
  box-shadow: 4px 4px 0 #000;
  font-weight: 700;
  @media (prefers-reduced-motion: no-preference) {
    transition: transform 80ms, box-shadow 80ms, background-color 80ms;
  }

  &:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 #000;
  }

  &:active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 #000;
  }

  &:focus-visible {
    box-shadow: 4px 4px 0 #000 !important;
  }
}

.button-primary {
  border: 2px solid var(--si-green-dark);
  background: var(--si-green);
  color: #fff;

  &:hover,
  &:active {
    background: var(--si-green-dark);
    color: #fff;
  }
}

.button-secondary {
  border: 2px solid var(--si-ink);
  background: transparent;
  color: var(--si-ink);

  &:hover,
  &:active {
    background: var(--si-panel);
    color: var(--si-ink);
  }
}

// Sidhuvud och sidfot som sajtens topbar
.header {
  border-bottom: 2px solid var(--si-line);
  background: rgba(10, 14, 23, 0.94);
}

.header__nav-item a {
  font-family: var(--si-sans);
  font-weight: 600;
}

.footer {
  border-top: 2px solid var(--si-line);
  background: var(--si-bg);
  color: var(--si-faint);

  a {
    color: var(--si-ink-2);
  }
}

.footer__copyright {
  font-family: var(--si-mono);
  font-size: 13px;
}

// Kurs- och paketsidan: banan
// ======================================

.course-landing-page,
.bundle-landing-page {
  background: var(--si-bg);
  color: var(--si-ink-2);

  // HUD-etiketten ovanför rubriken
  .si-eb {
    margin: 0 0 16px;
    color: var(--si-green-text);
    font-family: var(--si-pixel);
    font-size: 13px;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .section__heading {
    color: var(--si-ink);
  }

  .section__subheading {
    color: var(--si-muted);
  }

  // Bannern: mörk bana med en plattform under
  .banner--course,
  .banner--bundle {
    position: relative;
    border-bottom: 4px solid var(--si-plat-top);
    background-color: var(--si-bg);
    background-image:
      radial-gradient(circle at 85% 20%, rgba(46, 158, 99, 0.16), transparent 45%),
      linear-gradient(rgba(36, 48, 74, 0.35) 1px, transparent 1px),
      linear-gradient(90deg, rgba(36, 48, 74, 0.35) 1px, transparent 1px);
    background-size: auto, 40px 40px, 40px 40px;

    .section__heading {
      color: var(--si-ink);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.04;
    }

    .section__subheading {
      max-width: 720px;
      color: var(--si-muted);
      font-size: clamp(17px, 1.4vw, 20px);
      line-height: 1.5;
    }

    .section__image,
    .section__video {
      border: 2px solid var(--si-line);
      box-shadow: 8px 8px 0 #000;
    }
  }

  // Frågetecken-block till höger i bannern, bara på bred skärm
  .si-level {
    display: none;

    @media (min-width: 1100px) {
      display: block;
      position: absolute;
      right: 6vw;
      bottom: 0;
      width: 260px;
    }
  }

  // Texten får inte gå in under blocken
  @media (min-width: 1100px) {
    .banner--course:not(.section--has-media) .banner__wrapper {
      padding-right: 320px;
    }
  }

  .si-level__blocks {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 72px;
  }

  .si-level__plat {
    height: 56px;
    border-top: 4px solid var(--si-green);
    background: var(--si-plat);
  }

  .si-qb {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border: 3px solid var(--si-gold-dark);
    background: var(--si-gold);
    box-shadow: inset -5px -5px 0 rgba(0, 0, 0, 0.25), inset 5px 5px 0 rgba(255, 255, 255, 0.3);
    color: #3d2a00;
    font-family: var(--si-pixel);
    font-size: 22px;

    &--green {
      border-color: var(--si-green-dark);
      background: var(--si-green);
      color: #fff;
    }

    @media (prefers-reduced-motion: no-preference) {
      animation: si-bob 2.4s ease-in-out infinite;

      &:nth-child(2) {
        animation-delay: 0.3s;
      }

      &:nth-child(3) {
        animation-delay: 0.6s;
      }
    }
  }

  @keyframes si-bob {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-6px);
    }
  }

  // Omfattningen som HUD-rad: siffror i pixelfont
  .si-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 28px 0 32px;
    padding: 0;
    list-style: none;
    color: var(--si-faint);
    font-family: var(--si-mono);
    font-size: 14px;

    strong {
      margin-right: 6px;
      color: var(--si-gold);
      font-family: var(--si-pixel);
      font-size: 18px;
      font-weight: 400;
    }
  }

  .product-action-buttons__additional-prices {
    border: 2px solid var(--si-line);
    border-radius: 0;
    background: var(--si-panel);
    color: var(--si-ink);
  }

  // Fördelarna (ikon och text): kort med ett grönt frågetecken-block
  .text-icon__list-item {
    padding: 28px 24px;
    text-align: left;
    border: 2px solid var(--si-line);
    background: var(--si-panel);

    > i.fa {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      margin-bottom: 20px;
      border: 3px solid var(--si-green-dark);
      background: var(--si-green);
      box-shadow: inset -4px -4px 0 rgba(0, 0, 0, 0.25), inset 4px 4px 0 rgba(255, 255, 255, 0.3);
      color: #fff;
      font-size: 20px;
    }

    .section__heading--secondary {
      color: var(--si-ink);
    }

    p {
      color: var(--si-muted);
    }
  }

  // Text och bild, löptext
  .text-image__image img,
  .rich-text img {
    border: 2px solid var(--si-line);
    box-shadow: 8px 8px 0 #000;
  }

  .section__body {
    color: var(--si-ink-2);
  }

  // Kursplanen: varje kapitel är ett numrerat block på en plattform
  .course-curriculum__chapter-list {
    counter-reset: si-chapter;

    .course-curriculum__chapter {
      counter-increment: si-chapter;
      margin-bottom: 12px;
      border: 2px solid var(--si-line);
      border-bottom: 4px solid var(--si-plat-top);
      background: var(--si-panel);
    }
  }

  .course-curriculum__chapter-header {
    gap: 16px;
    padding: 16px 20px;

    &::before {
      content: counter(si-chapter);
      display: flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border: 3px solid var(--si-green-dark);
      background: var(--si-green);
      box-shadow: inset -4px -4px 0 rgba(0, 0, 0, 0.25), inset 4px 4px 0 rgba(255, 255, 255, 0.3);
      color: #fff;
      font-family: var(--si-pixel);
      font-size: 14px;
      line-height: 1;
    }

    .toga-icon {
      color: var(--si-green-text);
    }
  }

  .course-curriculum__chapter-title {
    flex: 1;
    color: var(--si-ink);
    font-family: var(--si-sans);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
  }

  .course-curriculum__chapter-content {
    padding: 0 20px 12px 72px;
    color: var(--si-ink-2);

    li {
      margin-bottom: 4px;
    }
  }

  .course-curriculum__chapter-lesson {
    i {
      color: var(--si-faint);
      font-size: 18px;
    }

    &--free {
      border-radius: 0;
      background: var(--si-gold);
      color: #3d2a00;
      font-family: var(--si-pixel);
      font-size: 11px;
    }
  }

  .course-curriculum__chapter-toggle .button--link {
    color: var(--si-green-text);
    font-family: var(--si-pixel);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  // Kortet bredvid kursplanen
  .course-curriculum-card {
    border: 2px solid var(--si-line);
    border-radius: 0;
    background: var(--si-panel);
    box-shadow: 8px 8px 0 #000;

    @media (min-width: 992px) {
      position: sticky;
      top: 104px;
    }

    img {
      border-bottom: 2px solid var(--si-line);
    }

    hr {
      background: var(--si-green);
    }
  }

  .course-curriculum-card__details-item {
    color: var(--si-ink-2);
    font-family: var(--si-mono);
    font-size: 14px;

    i {
      color: var(--si-green-text);
    }
  }

  // Instruktören
  .instructor__list-item {
    padding: 28px;
    border: 2px solid var(--si-line);
    background: var(--si-panel);
  }

  .instructor__avatar-img {
    border: 3px solid var(--si-green-dark);
    border-radius: 0;
    box-shadow: 6px 6px 0 #000;
  }

  .instructor__title {
    display: block;
    margin-bottom: 8px;
    color: var(--si-green-text);
    font-family: var(--si-pixel);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .instructor__bio {
    color: var(--si-ink-2);
  }

  // Avslutande uppmaning: panel med plattform
  .cta-course {
    border-top: 2px solid var(--si-line);
    background: var(--si-bg-alt);
  }

  .cta-course__wrapper {
    padding: 48px 40px;
    border: 2px solid var(--si-line);
    border-bottom: 6px solid var(--si-green);
    background: var(--si-panel);
  }

  // Vanliga frågor och omdömen följer samma kort
  .faq__item,
  .testimonial__item,
  .reviews__item {
    border: 2px solid var(--si-line);
    border-radius: 0;
    background: var(--si-panel);
  }

  // Tegelmarken under banan, före sidfoten
  .si-ground {
    height: 40px;
    background-color: var(--si-ground);
    background-image:
      linear-gradient(var(--si-bg) 2px, transparent 2px),
      linear-gradient(90deg, var(--si-bg) 2px, transparent 2px);
    background-size: 40px 20px;
  }

  .footer {
    border-top: 0;
  }
}
