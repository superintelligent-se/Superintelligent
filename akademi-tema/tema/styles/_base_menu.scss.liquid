// Lists
// ======================================

[class*="__wrapper"] {
  & > [class*="__menu"] {
    li {
      display: block;

      a {
        @include transition(color 0 ease);

        display: block;
        position: relative;
        padding: $padding-base $padding-2;
        color: $link__color;
        text-align: left;
        text-decoration: underline;
        font-weight: 600;

        &.active,
        &:active,
        &:hover,
        &:focus {
          text-decoration: none;
        }

        &:before {
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          width: 0;
          height: 100%;
          background-color: $accent__color;
          content: "";
        }

        &:active,
        &.active {
          &:before {
            @include transition(width 300ms ease-in-out);

            width: 5px;
          }
        }

        &.active {
          text-decoration: none;
          font-weight: 600;
        }
      }
    }

    @media screen and (min-width: $screen-md) and (max-width: $screen-md-max) {
      ul {
        border: 0;
        border-bottom: $interface__border;
        font-size: 0;
      }

      li {
        display: inline-block;
        width: auto;

        &:first-child {
          a {
            border-left: $interface__border;
          }
        }

        a {
          position: relative;
          top: 1px;
          border-top: $interface__border;
          border-right: $interface__border;
          font-size: 1rem;

          &:before {
            content: none;
          }

          &.active {
            border-bottom: 1px solid $interface__background-color;
            text-decoration: none;
            font-weight: 600;
          }

          &.active,
          &:active,
          &:hover {
            border-bottom-color: $body__background-color;
            background-color: $body__background-color;
          }
        }
      }
    }
  }
}
