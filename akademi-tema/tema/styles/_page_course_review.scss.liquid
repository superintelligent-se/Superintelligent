// Course & Course Reviews
// ======================================

// Course Review
.course-review {
  @include page-padding;

  &__container {
    @include make-container;
  }

  &__wrapper {
    @include make-row(true);
    justify-content: center;
  }

  &__heading {
    @include page-heading;
  }

  &__course-name {
    @include h2;
  }

  &__form {
    @include screen-lg-min {
      @include make-col(6);
    }
    @include screen-md-min {
      @include make-col(8);
    }
    @include make-col(12);

    .review__stars {

      input {
        width: 2rem;
        height: 2rem;
        margin-left: -0.15rem;

        &:focus {
          outline-offset: 0;
          outline-style: dotted;
        }
      }
    }

    .review__star {
      position: absolute;
      top: 0;
      left: 0;
      width: 2rem;
      height: 2rem;
      font-size: 2rem;
      letter-spacing: 0.42rem;
    }

    .review__stars-input {
      display: block;
      margin-top: 1rem;
      overflow: visible;

      &:before {
        font-size: 2rem;
      }
    }

    .review__star ~ .review__star {
      left: 1.677777rem * 1.25;
    }

    .review__star ~ .review__star ~ .review__star {
      left: 1.677777rem * 2.5;
    }

    .review__star ~ .review__star ~ .review__star ~ .review__star {
      left: 1.677777rem * 3.75;
    }

    .review__star
      ~ .review__star
      ~ .review__star
      ~ .review__star
      ~ .review__star {
      left: 1.677777rem * 4.9;
    }
  }

  &__submit {
    padding-top: $gutter-width * 1.5;
  }
}
