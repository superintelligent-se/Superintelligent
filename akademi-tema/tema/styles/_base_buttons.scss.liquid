// Buttons
// ======================================

button {
  &:focus-visible {
    outline: none;
    box-shadow: $shadow-chalk-focus !important;
  }
}

.button {
  @include button;
}

.button-block {
  display: block;
  width: 100%;
}

.button-large {
  padding: $button__padding--large;
}

.button-primary {
  @include button-primary;
}

.button-secondary {
  @include button-secondary;
}
