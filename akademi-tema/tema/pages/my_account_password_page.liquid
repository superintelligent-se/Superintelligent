{% comment %}
  This is the 'my account password' page.
  Here, a user can change their current password.
{% endcomment %}

<main class="my-account" id="main-content">
  <div class="my-account__container">
    <div class="my-account__wrapper">
      {% include 'my_account_menu' %}
      <div class="my-account__content">
        <h1 class="my-account__heading">{{ 'liquid.views.my_account_password_page.custom_header_change_password' | translate }}</h1>
        {% form 'my_account_password' %}
        {% if errors.size > 0 %}
          {% include 'form_errors' %}
        {% endif %}
        {% include 'password_field' %}
        {% include 'password_confirm_field' %}
        {% if site.current_user.has_password %}
          <div class="form__group">
            {% assign field = fields.current_password %}
            <label for="{{ field.name }}" class="form__label">
              {{ field.label }}
            </label>
            <input
              type="password"
              id="{{ field.name }}"
              name="{{ field.name }}"
              placeholder="{{ field.placeholder }}"
              {% if field.required %}required{% endif %}
              aria-describedby="{{ field.name }}-notice{% if field.required %} {{ field.name }}-error{% endif %}"
              autocapitalize="off"
              autocomplete="off"
              autocorrect="off"
              spellcheck="false"
              class="form__control"
            />
            <p class="form__notice" id="{{ field.name }}-notice">
              {{ 'liquid.views.my_account_password_page.custom_msg_current_password' | translate }}
            </p>
            {% if field.required %}
              <p id="{{ field.name }}-error" class="form__error-msg hidden">
                {{ 'liquid.partials.form.field_cannot_be_blank' | translate }}
              </p>
            {% endif %}
          </div>
        {% endif %}
        <div class="form__button-group">
          <input type="submit" name="commit" value="{{ fields.submit.label }}" class="button button-primary" />
        </div>
        {% endform %}
      </div>
    </div>
  </div>
</main>

{% include 'form_validation_script' %}
