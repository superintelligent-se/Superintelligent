{% assign sectionLabel = section.settings.heading %}
<section
  aria-label="{{ sectionLabel | escape }}"
  class="text-icon section-height__medium {% include 'section_utility_background_decoration' %} {% include 'section_utility_heading_alignment' %}"
  data-preview-item="text-icon">
  <div class="text-icon__container">
    {% include 'section_headings' %}
    <div class="section__content">
      {% if section.blocks != empty %}
        <div class="text-icon__container">
          <ul class="text-icon__list section__body">
            {% for block in section.blocks %}
              <li class="text-icon__list-item">
                <i class="fa {{ block.settings.ti_icon }}" aria-hidden="true"></i>
                <h3 class="section__heading--secondary">{{ block.settings.ti_name }}</h3>
                <p>{{ block.settings.ti_body }}</p>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}

.text-icon {
  {% if section.settings.section_background_decoration == true %}
    {% include 'section_style_background_decoration' %}
  {% else %}
    {% include 'section_style_background_color' %}
  {% endif %}
  {% include 'section_style_heading_alignment' %}

  {% if section.settings.section_padding_top %}
    .text-icon__container {
      padding-top: 0;
    }
  {% endif %}

  {% if section.settings.section_padding_bottom %}
    .text-icon__container {
      padding-bottom: 0;
    }
  {% endif %}
}

{% endstyle %}

{% schema %}
{
  "label":"Icons & text",
  "description":"",
  "previewImageUrl":"https://cdn.thinkific.com/57/20210222/87c9a4ceca53409bdda96604b29b2bcf.png",
  "previewDescription":"Highlight key points",
  "settings":[
    {
      "label":"Headings",
      "settings":[
        {
          "type":"text",
          "id":"heading",
          "label":"Heading",
          "default":"Det här får du"
        },
        {
          "type":"text",
          "id":"subheading",
          "label":"Subheading",
          "default":""
        },
        {
          "type":"radio",
          "id":"heading_alignment",
          "label":"Alignment",
          "description":"",
          "default":"left",
          "options":[
            {
              "value":"left",
              "label":"Left"
            },
            {
              "value":"center",
              "label":"Center"
            },
            {
              "value":"right",
              "label":"Right"
            }
          ]
        }
      ]
    },
    {
      "label":"Background & layout",
      "settings":[
        {
          "type":"select",
          "id":"background_color",
          "label":"Color",
          "description":"<small>Set your colors in Theme Settings</small>",
          "default":"background_2",
          "options":[
            {
              "value":"background_1",
              "label":"Primary"
            },
            {
              "value":"background_2",
              "label":"Secondary"
            }
          ]
        },
        {
          "type":"checkbox",
          "id":"section_background_decoration",
          "label":"Show styled background",
          "default":false
        },
        {
          "type":"checkbox",
          "id":"section_padding_top",
          "label":"Remove top section padding",
          "default":false
        },
        {
          "type":"checkbox",
          "id":"section_padding_bottom",
          "label":"Remove bottom section padding",
          "default":false
        }
      ]
    }
  ],
  "blocks":{
    "label":"Add icon & text",
    "limit":12,
    "types":[
      {
        "type":"icon_text",
        "label":"Icon & text",
        "settings":[
          {
            "type":"icon",
            "id":"ti_icon",
            "label":"Icon"
          },
          {
            "type":"text",
            "id":"ti_name",
            "label":"Name"
          },
          {
            "type":"textarea",
            "id":"ti_body",
            "label":"Description"
          }
        ]
      }
    ],
    "defaults":[
      {
        "type":"icon_text",
        "values":{
          "ti_icon":"fa-asterisk",
          "ti_name":"Icon & text",
          "ti_body":"Use an icon and text to communicate the value proposition and share the specific benefits of your offering. What makes it unique in your market?"
        }
      },
      {
        "type":"icon_text",
        "values":{
          "ti_icon":"fa-area-chart",
          "ti_name":"Icon & text",
          "ti_body":"Use an icon and text to communicate the value proposition and share the specific benefits of your offering. What makes it unique in your market?"
        }
      },
      {
        "type":"icon_text",
        "values":{
          "ti_icon":"fa-lightbulb-o",
          "ti_name":"Icon & text",
          "ti_body":"Use an icon and text to communicate the value proposition and share the specific benefits of your offering. What makes it unique in your market?"
        }
      }
    ]
  }
}
{% endschema %}
