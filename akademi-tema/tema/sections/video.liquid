{% assign sectionLabel = section.settings.heading %}
<section
  aria-label="{{ sectionLabel | escape }}"
  class="video {% include 'section_utility_background' %} {% include 'section_utility_content_alignment' %} {% include 'section_utility_height_preset' %}"
  data-preview-item="video"
>
  <div class="video__container">
    <div class="section__content">
      <div class="section__content__wrapper">
        <button class="video__play-button" aria-label="Play video"><i class="fa fa-play" aria-hidden="true"></i></button>
        {% if section.settings.video.popover != blank %}
          <div class="section__video--trigger">
            {{ section.settings.video.popover }}
          </div>
        {% endif %}
        {% include 'section_headings' %}
      </div>
    </div>
  </div>
</section>

{% style %}
  .video {
    {% include 'section_style_background_color' %}
    {% if section.settings.background_image == blank %}
      {% include 'section_style_text_default' %}
    {% else %}
      {% include 'section_style_background' %}
    {% endif %}
    {% include 'section_style_content_alignment' %}
  }
{% endstyle %}

{% schema %}
{
  "label":"Video",
  "description":"",
  "previewImageUrl":"https://cdn.thinkific.com/57/20210222/9bc3e53b8f0b4e6288d83609d2617164.png",
  "previewDescription":"Engage your visitors with video",
  "settings":[
    {
      "label":"Headings",
      "settings":[
        {
          "type":"text",
          "id":"heading",
          "label":"Heading",
          "default":"Video"
        },
        {
          "type":"text",
          "id":"subheading",
          "label":"Subheading",
          "default":""
        }
      ]
    },
    {
      "label":"Video",
      "settings":[
        {
          "type":"video",
          "id":"video",
          "label":"",
          "description":"<small>Upload videos to your Thinkific site in the <a href='/manage/videos' target='_blank'>Video Library</a>.</small>",
          "default":{
            "id":false,
            "type":"",
            "url":"",
            "identifier":"",
            "frame":"",
            "popover":"",
            "oembed":false
          }
        }
      ]
    },
    {
      "label":"Background",
      "settings":[
        {
          "type":"select",
          "id":"background_color",
          "label":"Color",
          "description":"<small>Set your colors in Theme Settings</small>",
          "default":"background_2",
          "options":[
            {
              "value":"background_1",
              "label":"Primary"
            },
            {
              "value":"background_2",
              "label":"Secondary"
            }
          ]
        },
        {
          "type":"image",
          "id":"background_image",
          "default":"",
          "label":"Image",
          "description":"<small>Recommended: <strong>1440px x 720px (1MB)</strong></small>"
        },
        {
          "type":"image_origin",
          "id":"background_image_origin",
          "default": "center center",
          "label":"Image focal point"
        },
        {
          "type":"color",
          "id":"overlay_color",
          "label":"Overlay color",
          "default":"#000000"
        },
        {
          "type":"number",
          "id":"overlay_opacity",
          "label":"Overlay opacity",
          "default":30,
          "min":0,
          "max":100
        },
        {
          "type":"color",
          "id":"text_color",
          "label":"Text color override",
          "default":"#ffffff"
        }
      ]
    },
    {
      "label":"Size & alignment",
      "settings":[
        {
          "type":"select",
          "id":"section_height_preset",
          "label":"Height",
          "description":"",
          "default":"medium",
          "options":[
            {
              "value":"small",
              "label":"Small"
            },
            {
              "value":"medium",
              "label":"Medium"
            },
            {
              "value":"large",
              "label":"Large"
            },
            {
              "value":"xlarge",
              "label":"Extra large"
            }
          ]
        },
        {
          "type":"radio",
          "id":"content_alignment",
          "label":"Alignment",
          "default":"center",
          "options":[
            {
              "value":"left",
              "label":"Left"
            },
            {
              "value":"center",
              "label":"Center"
            },
            {
              "value":"right",
              "label":"Right"
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
