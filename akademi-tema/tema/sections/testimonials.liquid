{% assign sectionLabel = section.settings.heading %}
<section
  aria-label="{{ sectionLabel | escape }}"
  class="testimonials section-height__medium {% include 'section_utility_heading_alignment' %}"
  data-preview-item="testimonials"
>
  <div class="testimonials__container">
    {% include 'section_headings' %}
    <div class="section__content">
      {% if section.blocks != empty %}
        <div class="testimonials__list section__body" role="list">
          {% for block in section.blocks %}
            <div class="testimonials__list-item" role="listitem">
              {% if block.settings.testimonial_avatar != empty %}
                <img
                  src="{{ block.settings.testimonial_avatar }}"
                  srcset="{{ block.settings.testimonial_avatar }}?width=100&dpr=1 1x, {{ block.settings.testimonial_avatar }}?width=100&dpr=2 2x, {{ block.settings.testimonial_avatar }}?width=100&dpr=3 3x"
                  alt=""
                  loading="lazy"
                  width="100"
                />
              {% endif %}
              {% if block.settings.testimonial_title != nil %}
                <h3 class="testimonial__title section__heading--secondary">{{ block.settings.testimonial_title }}</h3>
              {% endif %}
              <p class="testimonial__author">{{ block.settings.testimonial_author }}</p>
              <div>
                {{ block.settings.testimonial_body }}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
.testimonials {
  {% include 'section_style_heading_alignment' %}

  {% if section.settings.section_padding_top %}
    .testimonials__container {
      padding-top: 0;
    }
  {% endif %}

  {% if section.settings.section_padding_bottom %}
    .testimonials__container {
      padding-bottom: 0;
    }
  {% endif %}
}
{% endstyle %}

{% schema %}
{
  "label":"Social proof: testimonials",
  "description":"",
  "previewImageUrl":"https://cdn.thinkific.com/57/20210222/d18c657a28c297f756a6107271b6c8ed.png",
  "previewDescription":"Show off your happy customers",
  "settings":[
    {
      "label":"Headings",
      "settings":[
        {
          "type":"text",
          "id":"heading",
          "label":"Heading",
          "default":"Social proof: testimonials"
        },
        {
          "type":"text",
          "id":"subheading",
          "label":"Subheading",
          "default":""
        },
        {
          "type":"radio",
          "id":"heading_alignment",
          "label":"Alignment",
          "description":"",
          "default":"center",
          "options":[
            {
              "value":"left",
              "label":"Left"
            },
            {
              "value":"center",
              "label":"Center"
            },
            {
              "value":"right",
              "label":"Right"
            }
          ]
        }
      ]
    },
    {
      "label":"Layout",
      "settings":[
        {
          "type":"checkbox",
          "id":"section_padding_top",
          "label":"Remove top section padding",
          "default":false
        },
        {
          "type":"checkbox",
          "id":"section_padding_bottom",
          "label":"Remove bottom section padding",
          "default":false
        }
      ]
    }
  ],
  "blocks":{
    "label":"Add testimonial",
    "limit":10,
    "types":[
      {
        "type":"testimonial",
        "label":"Testimonial",
        "settings":[
          {
            "type":"text",
            "id":"testimonial_title",
            "label":"Testimonial title"
          },
          {
            "type":"text",
            "id":"testimonial_author",
            "label":"Author's name"
          },
          {
            "type":"image",
            "id":"testimonial_avatar",
            "label":"Avatar",
            "default":"https://cdn.thinkific.com/13/20180205/39756c0116e7c268ccc233356a72736d.png"
          },
          {
            "type":"textarea",
            "id":"testimonial_body",
            "label":"Text"
          }
        ]
      }
    ],
    "defaults":[
      {
        "type":"testimonial",
        "values":{
          "testimonial_title":"Testimonial title",
          "testimonial_author":"by Author's name",
          "testimonial_avatar":"https://cdn.thinkific.com/13/20180205/39756c0116e7c268ccc233356a72736d.png",
          "testimonial_body":"Share testimonials about you, your course, or your content. Don't be afraid to reach out to your network to get some glowing words about the work you've done. Most potential students will look to the opinions of others when making purchase decisions online."
        }
      }
    ]
  }
}
{% endschema %}
